CONFIG_STAGING=y
CONFIG_ASHMEM=y
CONFIG_SYNC_FILE=y
CONFIG_SW_SYNC=y
CONFIG_ANDROID=y
# Binder from android-4.9-q: binder/hwbinder/vndbinder devices with the
# scatter-gather + FD-array objects needed by HIDL. The LineageOS 17.1/18.1
# userspace for gtelwifi/gtel3g is built with binder32bit (its 3.10 kernel
# uses ANDROID_BINDER_IPC_32BIT=y), so keep the 32-bit protocol (v7):
# with v8 every open of binder/hwbinder/vndbinder fails the version check.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDER_IPC_32BIT=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ION=y
CONFIG_ION_SPRD=y
