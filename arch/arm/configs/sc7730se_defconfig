# Spreadtrum SC7730SE (Samsung SM-T560 / SM-T561) bring-up defconfig.
# Deliberately small: get a log out of the device first, everything else later.
# There is no UART jig in this setup, so the persistent RAM console (pstore/
# ramoops, region declared in the board DTS) is the primary debug channel and
# is read back from TWRP - see docs/DEBUG-TWRP.md.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOG_BUF_SHIFT=18
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_EMBEDDED=y
CONFIG_PERF_EVENTS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_SPRD=y
CONFIG_ARCH_SC7730SE=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_HOTPLUG_CPU=y
CONFIG_HZ_100=y
CONFIG_PREEMPT=y
CONFIG_AEABI=y
CONFIG_HIGHMEM=y
CONFIG_CMA=y
CONFIG_ARM_APPENDED_DTB=y
# The appended DTB has to be the authority on the command line. A dump taken
# from recovery shows the Samsung bootloader builds its own line, ignores the
# one in the boot.img header, and puts "console=null loglevel=0" in it. With
# ATAG_DTB_COMPAT the decompressor folds exactly that into /chosen/bootargs,
# overwriting ours and silently dropping the nosmp variant of the image. The
# ATAG memory map is no loss: mem=1536M matches the DTS memory node.
# CONFIG_ARM_ATAG_DTB_COMPAT is not set
# initcall_debug names every initcall as it runs, so the last line in the RAM
# console identifies a silent hang; ignore_loglevel forces everything out.
CONFIG_CMDLINE="console=ttyS1,115200n8 earlycon=sprd_serial,0x70100000 no_console_suspend initcall_debug ignore_loglevel"
# appended to the DTB command line, so these survive even if something else
# rewrites /chosen/bootargs
CONFIG_CMDLINE_EXTEND=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y
CONFIG_BINFMT_MISC=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_DMA_CMA=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_SIZE=65536
CONFIG_INPUT_EVDEV=y
# CONFIG_LEGACY_PTYS is not set
CONFIG_SERIAL_SPRD=y
CONFIG_SERIAL_SPRD_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
# CONFIG_HW_RANDOM is not set
CONFIG_MFD_SYSCON=y
# CONFIG_HWMON is not set
# CONFIG_USB_SUPPORT is not set
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
# persistent RAM console: the only way to see anything without a UART jig
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PRINTK_TIME=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_FS=y
# turn silent hangs into something the RAM console actually records
CONFIG_PANIC_ON_OOPS=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=60
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_LOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
# a bad boot is diagnosed by dumping RAM from recovery, so keep /dev/mem open
# CONFIG_STRICT_DEVMEM is not set
# CONFIG_CRYPTO_ANSI_CPRNG is not set
