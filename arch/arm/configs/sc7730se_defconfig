# Real battery: SC2723 fuel gauge ("battery") + VCHG charger detect ("ac"),
# SMB358 read for charge status only. A battery power_supply must exist:
# without one Android 11 healthd reports "no battery" and SystemUI
# crash-loops in BatteryMeterView, so test_power stays off (two batteries
# would confuse healthd).
CONFIG_POWER_SUPPLY=y
