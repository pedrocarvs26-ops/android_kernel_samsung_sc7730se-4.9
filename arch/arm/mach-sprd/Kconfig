menuconfig ARCH_SPRD
	bool "Spreadtrum (UNISOC) SoCs"
	depends on ARCH_MULTI_V7
	select ARM_GIC
	select COMMON_CLK
	# early_console.c paints VGA8x16 glyphs (opt-in, sprd_early_panel=1)
	select FONT_SUPPORT
	select GENERIC_IRQ_CHIP
	select GPIOLIB
	select IRQ_DOMAIN
	select MFD_SYSCON
	select OF_GPIO
	select PINCTRL
	select SPRD_TIMER
	help
	  Support for Spreadtrum (UNISOC) 32-bit ARMv7 SoCs.

if ARCH_SPRD

config ARCH_SC7730SE
	bool "Spreadtrum SC7730SE / SC8830 (scx35 / scx30g) family"
	default y
	select ARM_ERRATA_764369 if SMP
	help
	  Support for the Spreadtrum SC7730SE (SC8830 "shark"/scx35/scx30g family)
	  quad Cortex-A7 SoC, as found in the Samsung Galaxy Tab E 9.6
	  (SM-T560 "gtelwifi" and SM-T561 "gtel3g").

	  Note: Cortex-A7 MPCore has no SCU MMIO block at PERIPHBASE+0x0000
	  (0x12000000 is reserved and aborts on access). Secondary CPUs are
	  brought up by mach-sprd/platsmp.c through the PMU_APB power domains
	  and the SCX30G AP_AHB holding pen (0x14) and CPU jump (0x18..0x24)
	  registers.

endif
