/dts-v1/;

/*
 * Samsung Galaxy Tab E 9.6 Wi-Fi (SM-T560, "gtelwifi")
 * Spreadtrum SC7730SE, 1.5 GB RAM, 800x1280 panel.
 *
 * The stock bootloader boots a zImage with an appended DTB inside a
 * Samsung boot.img, and passes its own command line; the bootargs below
 * are only used when the bootloader does not override them.
 *
 * This file is dual-licensed: GPL-2.0 or X11.
 */

#include "sc7730se.dtsi"

/ {
	model = "Samsung Galaxy Tab E 9.6 Wi-Fi (SM-T560)";
	compatible = "samsung,gtelwifi", "sprd,sc7730se";

	chosen {
		stdout-path = "serial1:115200n8";
		bootargs = "console=ttyS1,115200n8 earlycon=sprd_serial,0x70100000 no_console_suspend rw";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x60000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * Persistent kernel log, read back from TWRP after a failed boot.
		 * This is the only debug channel on a device without a UART jig,
		 * see docs/DEBUG-TWRP.md.
		 *
		 * The address is not a guess. The stock command line, recovered
		 * out of DRAM from recovery, contains
		 * "sec_log=0xffe00@0x86b00000": the Samsung bootloader keeps
		 * 0x86b00000..0x86c00000 out of the usable memory map on every
		 * boot, recovery included, for the stock RAM console. Our zone
		 * sits in the upper half of that window because the recovery
		 * kernel writes its own sec_log from the base upwards and only
		 * produces a few tens of KiB, so the 512 KiB below us acts as a
		 * sacrificial buffer.
		 *
		 * The first attempt put this at 0x89b00000, the top of the modem
		 * window. A dump from the device came back full of live SIPC ring
		 * buffer names (sbuf_0_*, sblock_0_*), so that memory belongs to
		 * the CP. The framebuffer and ION regions are no better: TWRP
		 * draws its UI in one and allocates from the other.
		 *
		 * record-size = <0> leaves the console zone as the only zone, so
		 * it starts at the base of the region and stays plain text: 4.9
		 * stores dmesg records zlib-compressed, but never the console.
		 * The 12-byte header (sig 0x43474244 "DBGC", start, size) is the
		 * same layout Samsung's own sec_log uses on this SoC.
		 */
		ramoops@86b80000 {
			compatible = "ramoops";
			reg = <0x86b80000 0x60000>;
			console-size = <0x60000>;
			record-size = <0>;
			ecc-size = <0>;
		};

		/* shared memory with the modem/DSP side */
		smem_reserved: smem@87800000 {
			reg = <0x87800000 0x240000>;
			no-map;
		};

		/*
		 * CP (modem) firmware window, kept even on Wi-Fi only models.
		 * It runs all the way to 0x89c00000: the RAM console used to be
		 * carved out of the top megabyte, which is exactly why the first
		 * dump came back full of modem data.
		 */
		cp_reserved: cp-modem@88000000 {
			reg = <0x88000000 0x1c00000>;
			no-map;
		};

		/* framebuffer handed over by the bootloader */
		fb_reserved: framebuffer@9ea44000 {
			reg = <0x9ea44000 0x00bb8000>;
			no-map;
		};

		ion_reserved: ion@9f5fc000 {
			reg = <0x9f5fc000 0x007d4000>;
			no-map;
		};
	};
};

&uart0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};
