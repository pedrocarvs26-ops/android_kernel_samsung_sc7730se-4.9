/*
 * Spreadtrum SC7730SE (SC8830 / "scx35" family) SoC
 *
 * Quad Cortex-A7 @ up to 1.3 GHz, Mali-400 MP2, no PSCI.
 * Addresses were recovered from the Samsung/Spreadtrum 3.10 vendor kernel
 * (arch/arm/mach-sc/include/mach/__hardware-sc8830.h), which describes the
 * hardware with a static virtual iomap; here everything is expressed with
 * the real physical addresses so the kernel can ioremap it normally.
 *
 * This file is dual-licensed: GPL-2.0 or X11.
 */

#include <dt-bindings/interrupt-controller/arm-gic.h>

/ {
	compatible = "sprd,sc7730se";
	interrupt-parent = <&gic>;
	#address-cells = <1>;
	#size-cells = <1>;

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@f00 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0xf00>;
		};

		cpu1: cpu@f01 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0xf01>;
		};

		cpu2: cpu@f02 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0xf02>;
		};

		cpu3: cpu@f03 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0xf03>;
		};
	};

	pmu {
		compatible = "arm,cortex-a7-pmu";
		interrupts = <GIC_SPI 92 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 93 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>;
	};

	/*
	 * Placeholder fixed clocks. The SC7730SE clock tree lives in the
	 * AON_APB/AP_CLK blocks and is not modelled yet; the bootloader
	 * leaves the few clocks we need (UART, timers) running.
	 */
	ext_26m: clock-ext-26m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "ext-26m";
	};

	ext_32k: clock-ext-32k {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "ext-32k";
	};

	clk_48m: clock-48m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <48000000>;
		clock-output-names = "clk-48m";
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		scu@12000000 {
			compatible = "arm,cortex-a7-scu";
			reg = <0x12000000 0x100>;
		};

		gic: interrupt-controller@12001000 {
			compatible = "arm,cortex-a7-gic";
			#interrupt-cells = <3>;
			#address-cells = <0>;
			interrupt-controller;
			reg = <0x12001000 0x1000>,
			      <0x12002000 0x2000>;
		};

		ap_ahb: syscon@20d00000 {
			compatible = "sprd,scx35-ap-ahb", "syscon";
			reg = <0x20d00000 0x10000>;
		};

		pmu_apb: syscon@402b0000 {
			compatible = "sprd,scx35-pmu-apb", "syscon";
			reg = <0x402b0000 0x10000>;
		};

		aon_apb: syscon@402e0000 {
			compatible = "sprd,scx35-aon-apb", "syscon";
			reg = <0x402e0000 0x10000>;
		};

		ap_apb: syscon@71300000 {
			compatible = "sprd,scx35-ap-apb", "syscon";
			reg = <0x71300000 0x10000>;
		};

		/*
		 * AON GPTIMER0, timer 0. Always-on, clocked from the 32.768 kHz
		 * oscillator, so it keeps running in deep idle.
		 */
		timer@40050000 {
			compatible = "sprd,scx35-timer";
			reg = <0x40050000 0x20>;
			interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ext_32k>;
			sprd,syscon-aon-apb = <&aon_apb>;
		};

		/* free running system counter, used as clocksource/sched_clock */
		syscnt@40230000 {
			compatible = "sprd,scx35-syscnt";
			reg = <0x40230000 0x1000>;
			clocks = <&ext_32k>;
		};

		uart0: serial@70000000 {
			compatible = "sprd,sc9836-uart";
			reg = <0x70000000 0x100>;
			interrupts = <GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_48m>;
			status = "disabled";
		};

		uart1: serial@70100000 {
			compatible = "sprd,sc9836-uart";
			reg = <0x70100000 0x100>;
			interrupts = <GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ext_26m>;
			status = "disabled";
		};

		uart2: serial@70200000 {
			compatible = "sprd,sc9836-uart";
			reg = <0x70200000 0x100>;
			interrupts = <GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ext_26m>;
			status = "disabled";
		};

		uart3: serial@70300000 {
			compatible = "sprd,sc9836-uart";
			reg = <0x70300000 0x100>;
			interrupts = <GIC_SPI 5 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ext_26m>;
			status = "disabled";
		};
	};
};
